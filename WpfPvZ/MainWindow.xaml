<Window x:Class="WpfPvZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plants vs Zombies" Height="682" Width="1145">
    <Window.Resources>
        <Style x:Key="Seed" TargetType="Button">
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*" MaxHeight="140"/>
            <RowDefinition Height="0.8*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*"/>
            <ColumnDefinition Width="0.2*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
                <ColumnDefinition Width="0.5*" MaxWidth="100" />
            </Grid.ColumnDefinitions>

            <Button Content="Кнопка 1" Grid.Column="0" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 2" Grid.Column="1" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 3" Grid.Column="2" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 4" Grid.Column="3" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 5" Grid.Column="4" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 6" Grid.Column="5" Style="{StaticResource Seed}" />
            <Button Content="Кнопка 7" Grid.Column="6" Style="{StaticResource Seed}" />
        </Grid>

        <StackPanel Grid.Column="1" Grid.Row="0">
            <Button Content="Пауза" Width="100"/>
        </StackPanel>

        <Canvas Grid.Row ="1" Grid.ColumnSpan="2" x:Name="GameCanvas"/>
    </Grid>
</Window>