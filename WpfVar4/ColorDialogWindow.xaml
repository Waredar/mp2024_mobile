<Window x:Class="WpfVar4.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Color" Height="300" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <Border Height="50" Background="{Binding SelectedColorPreview}" Margin="0,0,0,10" CornerRadius="5" />
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Красный" Margin="0,5,0,0" Width="60" />
                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Width="260" />
                    <TextBox Text="{Binding ElementName=RedSlider, Path=Value, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Зелёный" Margin="0,5,0,0" Width="60" />
                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Width="260" />
                    <TextBox Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Синий" Margin="0,5,0,0" Width="60" />
                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" Width="260" />
                    <TextBox Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="5,0,0,0" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,10,0,0">
            <Button Content="Ок" Width="75" Margin="5,0" Click="OKButton_Click" />
            <Button Content="Отмена" Width="75" Margin="5,0" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
