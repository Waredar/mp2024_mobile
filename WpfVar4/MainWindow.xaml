<Window x:Class="WpfVar4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfVar4"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MaxWidth="350"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30px"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0"
                    Grid.ColumnSpan="2">
            <Button Content="Сохранить" Padding="5" Click="SaveButton_Click"/>
            <Button Content="Открыть" Padding="5" Click="OpenButton_Click"/>
        </StackPanel>

        <Grid Grid.Column="0" Grid.Row="1" Margin="15px">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.65*"/>
                <RowDefinition/>
                <RowDefinition Height="0.1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="2" 
                    CornerRadius="15" Padding="5" Margin="0,5,0,0">
                <ScrollViewer  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Content="Круг" Width="50" Height="50" Margin="2" Click="Button_Click"/>
                        <Button Content="Прямоугольник" Width="50" Height="50" Margin="2" Click="Button_Click"/>
                        <Button Content="Треугольник" Width="50" Height="50" Margin="2" Click="Button_Click"/>
                       </WrapPanel>
                </ScrollViewer>
            </Border>
            <TextBlock Text="Фигуры" FontSize="16"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Background="White"
                       Padding="2" Grid.Row="0" Margin="20,-10,0,0" />

            <Border Margin="0, 20, 0, 0" Grid.Row="1" BorderBrush="Gray" BorderThickness="2" CornerRadius="15" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="5*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBox Text="{Binding Value}" Grid.Column="1" TextChanged="TextBox_TextChanged" />
                                    <Button Content="..." Grid.Column="2" VerticalAlignment="Center" Click="ColorPickerButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="FillColor">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Name}" Value="StrokeColor">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>


            <TextBlock Text="Свойства" Grid.Row="1" FontSize="16"
            HorizontalAlignment="Left" VerticalAlignment="Top" Background="White"
            Padding="2" Margin="20, 5,0,0" />

        </Grid>


        <Canvas Name="Draw" Grid.Column="1" Grid.Row="1" Background="LightGray">
            
        </Canvas>
            
    </Grid>
</Window>
