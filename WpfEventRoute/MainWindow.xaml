<Window x:Class="WpfEventRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfEventRoute"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="Clear" Click="ButtonClear_Click" Margin="5"/>
            
            <StackPanel Background="Aqua" Height="100"
                        MouseDown="All_MouseDown">
                <WrapPanel Background="Red" Height="70" MouseDown="All_MouseDown">
                    <TextBlock Background="Green" Height="50" Text="1224343431"
                               MouseDown="All_MouseDown"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Background="Aqua" Height="100"
                        PreviewMouseDown="All_MouseDown">
                <WrapPanel Background="Red" Height="70"
                           PreviewMouseDown="All_MouseDown">
                    <TextBlock Background="Green" Height="50" Text="1224343431"
                               PreviewMouseDown="All_MouseDown"/>
                </WrapPanel>
            </StackPanel>

            <StackPanel Background="Aqua" Height="100"
                        MouseEnter="All_MouseEnter">
                <WrapPanel Background="Red" Height="70"
                           MouseEnter="All_MouseEnter">
                    <TextBlock Background="Green" Height="50" Text="1224343431"
                               MouseEnter="All_MouseEnter"/>
                </WrapPanel>
            </StackPanel>

        </StackPanel>
        
        

        <ListBox Grid.Column="1" x:Name="lbLogs">
            
        </ListBox>
    </Grid>
</Window>
