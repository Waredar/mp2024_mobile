   "source": [
    "Queue queue = new();\n",
    "queue.Enqueue(5);\n",
    "queue.Enqueue(3.14);\n",
    "queue.Enqueue(\"Привет\");\n",
    "\n",
    "Console.WriteLine(\"Посмотреть -> \" + queue.Peek());\n",
    "queue"
   ]
