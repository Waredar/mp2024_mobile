<Window x:Class="WpfStyle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfStyle"
        mc:Ignorable="d"
        Title="MainWindow" Height="490" Width="300">

    <Window.Resources>
        <Style x:Key="style_1">
            <Setter Property="Control.Height" Value="50"/>
            <Setter Property="Control.FontSize" Value="21"/>
            <Setter Property="Control.Margin" Value="5"/>
        </Style>
        <Style x:Key="button_style_1" TargetType="Control">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="20"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Height" Value="70"/>
        </Style>
    </Window.Resources>
    
    <StackPanel>
        <Button Content="11111" Height="50" Margin="5" FontSize="21"/>
        <Button Content="111234" Style="{StaticResource style_1}"/>
        <Button Content="111234" Style="{StaticResource style_1}"/>
        <Button Content="111234" Style="{StaticResource button_style_1}"/>
        <Button Content="A"/>
        <Button Content="A"/>

    </StackPanel>
</Window>
